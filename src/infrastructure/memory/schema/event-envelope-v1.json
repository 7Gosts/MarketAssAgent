{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "marketassagent/session-event-envelope-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "event_id",
    "session_id",
    "seq",
    "tenant_id",
    "visibility_scope",
    "visibility_scope_id",
    "actor_id",
    "branch_id",
    "parent_event_id",
    "event_type",
    "event_class",
    "occurred_at",
    "recorded_at",
    "idempotency_scope",
    "idempotency_key",
    "schema_version",
    "payload",
    "payload_blob_ref",
    "producer",
    "record_checksum"
  ],
  "properties": {
    "format_version": {"const": 1},
    "event_id": {"type": "string", "pattern": "^ev_[0-9a-f]{40}$"},
    "session_id": {"type": "string", "pattern": "^sess_[0-9A-HJKMNP-TV-Z]{26}$"},
    "seq": {"type": "integer", "minimum": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "visibility_scope": {"enum": ["private", "group", "web"]},
    "visibility_scope_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": ["string", "null"]},
    "branch_id": {"type": "string", "pattern": "^br_[0-9A-HJKMNP-TV-Z]{26}$"},
    "parent_event_id": {"type": ["string", "null"]},
    "event_type": {"type": "string", "pattern": "^[a-z_]+/[a-z_]+$"},
    "event_class": {"enum": ["core", "aux"]},
    "occurred_at": {"type": "string"},
    "recorded_at": {"type": "string"},
    "idempotency_scope": {"type": "string"},
    "idempotency_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_version": {"type": "integer", "minimum": 1},
    "payload": {"type": ["object", "null"]},
    "payload_blob_ref": {"type": ["object", "null"]},
    "producer": {"type": "object"},
    "record_checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
